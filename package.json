{
	"name": "marianialessandro-monorepo",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"engines": {
		"node": ">=22.13.0"
	},
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"dev": "concurrently -n site,files,blog -c blue,green,magenta \"npm run dev:site\" \"npm run dev:files\" \"npm run dev:blog\"",
		"dev:site": "npm run dev --workspace @marianialessandro/marianialessandro.com",
		"dev:files": "npm run dev --workspace @marianialessandro/files.marianialessandro.com",
		"dev:blog": "npm run dev --workspace @marianialessandro/blog.marianialessandro.com",
		"dev:api": "composer dev --working-dir apps/api.marianialessandro.com",
		"build": "npm run build --workspaces --if-present",
		"build:site": "npm run build --workspace @marianialessandro/marianialessandro.com",
		"build:files": "npm run build --workspace @marianialessandro/files.marianialessandro.com",
		"build:blog": "npm run build --workspace @marianialessandro/blog.marianialessandro.com",
		"check": "npm run check --workspaces --if-present",
		"test:api": "composer test --working-dir apps/api.marianialessandro.com",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write ."
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.0",
		"@eslint/js": "^10.0.1",
		"concurrently": "^9.1.2",
		"eslint": "^10.8.0",
		"eslint-config-prettier": "^10.0.1",
		"eslint-plugin-svelte": "^3.22.0",
		"globals": "^16.0.0",
		"prettier": "^3.4.2",
		"prettier-plugin-svelte": "^3.3.3",
		"prettier-plugin-tailwindcss": "^0.6.11",
		"typescript-eslint": "^8.65.0"
	}
}
