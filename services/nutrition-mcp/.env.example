# Inject with the runtime's secret store / Docker --env-file. Do not commit real values.
MCP_RESOURCE=https://mcp.marianialessandro.com/mcp
OAUTH_ISSUER=https://YOUR_TENANT/
OAUTH_JWKS_URL=https://YOUR_TENANT/.well-known/jwks.json
OAUTH_TOKEN_URL=https://YOUR_TENANT/oauth/token
MCP_ALLOWED_SUBJECT=VERIFIED_PERSONAL_SUBJECT
# Require an access-token-only claim; configure the provider to emit it on this API audience.
OAUTH_ACCESS_CLAIM=https://mcp.marianialessandro.com/token_use
OAUTH_ACCESS_VALUE=access
NUTRITION_API_URL=https://api.marianialessandro.com/api/nutrition
NUTRITION_API_AUDIENCE=https://api.marianialessandro.com/nutrition
SERVICE_CLIENT_ID=VERIFIED_MACHINE_CLIENT_ID
SERVICE_CLIENT_SECRET=SET_IN_SECRET_MANAGER
# Use resource for RFC 8707 providers; audience for Auth0 client credentials after provider proof.
OAUTH_AUDIENCE_PARAMETER=audience
MCP_SCOPES=nutrition:read
# Empty permits reads only. Every mutation additionally requires its explicit operation ID.
MCP_OPERATIONS=
MCP_DIAGNOSTIC_ONLY=true
# Empty refuses requests with Origin, while permitting server-to-server requests without it.
MCP_ORIGINS=
MCP_MAX_INPUT=262144
MCP_MAX_OUTPUT=1048576
MCP_CONCURRENCY=8
MCP_DISABLED_FILE=/tmp/nutrition-mcp.disabled
