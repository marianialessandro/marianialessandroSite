{
    "name": "marianialessandro/nutrition-mcp",
    "type": "project",
    "require": {
        "php": "^8.3",
        "laravel/framework": "^13.8",
        "laravel/mcp": "^0.7",
        "laravel/passport": "^13.0",
        "firebase/php-jwt": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5.12"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.3.0"
        },
        "sort-packages": true
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ]
    },
    "license": "proprietary"
}
